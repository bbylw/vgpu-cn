---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { title = 'vgpu — 面向 WebGPU 的 TypeScript 库', description = '带类型的着色器导入、极简的 GPU 优先 API，同一份代码可在浏览器、无头 Node 以及测试套件中运行。' } = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#131311" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;700&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet" />
  </head>
  <body class="min-h-screen antialiased">
    <a href="#top" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded focus:bg-accent focus:px-4 focus:py-2 focus:text-[#131311]">跳到内容</a>
    <slot />
  </body>
</html>
